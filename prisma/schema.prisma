generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String    @default("")
  coverImageUrl String?   @map("cover_image_url")
  published     Boolean   @default(false)
  tags          String[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  comments Comment[]
  likes    Like[]

  @@index([published, createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  author    String   @default("Anonymous")
  content   String
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Desc)])
  @@index([ipHash, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, ipHash])
  @@index([postId])
  @@map("likes")
}

// Portfolio content (profile, experience, projects, education, certifications,
// skills, leadership) is no longer database-backed — it lives in data/*.json
// and ships statically. The former Postgres tables (profiles, experiences,
// projects, educations, certifications, skills, leaderships) still exist in
// Supabase but are unused; they were intentionally left in place rather than
// dropped here since this file only controls app code, not live data.
